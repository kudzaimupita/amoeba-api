option_settings:
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
    PORT: 8081
    JWT_ACCESS_EXPIRATION_MINUTES: 30
    JWT_REFRESH_EXPIRATION_DAYS: 30
    JWT_RESET_PASSWORD_EXPIRATION_MINUTES: 10
    JWT_VERIFY_EMAIL_EXPIRATION_MINUTES: 10
    JWT_SECRET: your-super-secret-jwt-key-change-this-in-production
    MONGODB_URL: mongodb+srv://kudzi:kudzi@servly-main-prod.pxy81.mongodb.net/?retryWrites=true&w=majority&appName=servly-main-prod
    MAILER_SEND_KEY: your_mailer_send_key_here
    ENCRYPTION_KEY: your_encryption_key_here
    CLAUDE_API: your_claude_api_key_here
    CONTROLLER_API_BASE: https://api.yourdomain.com
    CLIENT_URL: https://yourdomain.com

  aws:elasticbeanstalk:container:nodejs:
    NodeVersion: 18.17.0

  aws:elasticbeanstalk:environment:proxy:staticfiles:
    /static: /static

  aws:autoscaling:asg:
    MinSize: 1
    MaxSize: 10

  aws:autoscaling:trigger:
    BreachDuration: 5
    LowerBreachScaleIncrement: -1
    LowerThreshold: 20
    MeasureName: CPUUtilization
    Period: 5
    UpperBreachScaleIncrement: 1
    UpperThreshold: 80

  aws:elasticbeanstalk:healthreporting:system:
    SystemType: enhanced

  aws:elasticbeanstalk:cloudwatch:logs:
    StreamLogs: true
    DeleteOnTerminate: false
    RetentionInDays: 7

  aws:elasticbeanstalk:command:
    DeploymentPolicy: Rolling
    Timeout: 600 