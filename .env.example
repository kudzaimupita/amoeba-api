# Environment
NODE_ENV=development
PORT=3001

# Database
ENCRYPTION_KEY=
DEPLOYMENT_PROJECT_ENV_KEY=
# Docker Compose default (see docker-compose.yml mongo service):
# MONGODB_URL=mongodb://root:password@localhost:27017/servly?authSource=admin
MONGODB_URL=

# JWT Config
JWT_SECRET=supersecretkey
JWT_ACCESS_EXPIRATION_MINUTES=300
JWT_REFRESH_EXPIRATION_DAYS=300
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=100
JWT_VERIFY_EMAIL_EXPIRATION_MINUTES=100

# SMTP (Email) Configuration
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# AWS
APP_AWS_ACCESS_KEY=
APP_AWS_ACCESS_SECRET=
APP_AWS_REGION=us-east-1
APP_AWS_DEFAULT_AMI_ID=
APP_AWS_DEFAULT_INSTANCE_TYPE=t3.micro
APP_AWS_SSM_INSTANCE_PROFILE=
APP_AWS_CODEBUILD_ENABLED=true
APP_AWS_CODEBUILD_REGION=us-east-1
APP_AWS_CODEBUILD_PROJECT_NAME=servly-builds
APP_AWS_CODEBUILD_ALLOW_CREATE=false
APP_AWS_CODEBUILD_SERVICE_ROLE_ARN=
APP_AWS_CODEBUILD_IMAGE=aws/codebuild/standard:7.0
APP_AWS_CODEBUILD_COMPUTE_TYPE=BUILD_GENERAL1_MEDIUM
APP_AWS_CODEBUILD_TIMEOUT_MINUTES=60
APP_AWS_CODEBUILD_DOCKER_PRIVILEGED=true
APP_AWS_ECR_REPOSITORY=servly-deployments
APP_AWS_CODEBUILD_ARTIFACT_BUCKET=
INSTANCE_DEPLOYMENT_COMMAND_TIMEOUT_SECONDS=172800

# Mailer
MAILER_SEND_KEY=

# URLs
CLIENT_URL=
API_URL=
NODE_GATEWAY_SHARED_SECRET=
NODE_GATEWAY_INTERNAL_URL=http://localhost:8081
SERVLY_NODES_ENABLED=false
CONTROLLER_API_BASE=

# Payments
PAYSTACK_SECRET_KEY=

# AI
CLAUDE_API=
OPENAI_API_KEY=

# Prompt Optimization
USE_DYNAMIC_PROMPTS=false
DYNAMIC_PROMPT_PERCENTAGE=0

# Claude Rate Limiting
CLAUDE_REQUESTS_PER_MINUTE=45
CLAUDE_RATE_LIMIT_DELAY_MS=0

# Profiler
SCRAPE_MAX_LENGTH=20000

# Beta
BETA_WHITELIST_ENABLED=true

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# OAuth - GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
GITHUB_VCS_CLIENT_ID=
GITHUB_VCS_CLIENT_SECRET=
GITHUB_VCS_CALLBACK_URL=
# Backwards-compatible typo aliases; prefer GITHUB_VCS_*.
GITHUB_VSC_CLIENT_ID=
GITHUB_VSC_CLIENT_SECRET=
GITHUB_VSC_CALLBACK_URL=
GITHUB_REPO_LIST_MAX=1000
GITHUB_APP_SLUG=
GITHUB_APP_SETUP_CALLBACK_URL=
GITHUB_APP_ID=
# Full GitHub App .pem private key. Use escaped newlines or base64 encode the entire PEM.
GITHUB_APP_PRIVATE_KEY=
GITHUB_DEPLOYMENT_WEBHOOK_SECRET=

# OAuth - GitLab Source Access
GITLAB_VCS_CLIENT_ID=
GITLAB_VCS_CLIENT_SECRET=
GITLAB_VCS_CALLBACK_URL=
GITLAB_BASE_URL=https://gitlab.com
GITLAB_API_BASE_URL=https://gitlab.com/api/v4
GITLAB_REPO_LIST_MAX=1000
GITLAB_REPO_PAT=
GITLAB_DEPLOYMENT_WEBHOOK_SECRET=

# Bitbucket Source Access
BITBUCKET_USERNAME=
BITBUCKET_APP_PASSWORD=
BITBUCKET_REPO_LIST_MAX=1000
BITBUCKET_DEPLOYMENT_WEBHOOK_SECRET=

# OAuth - Figma
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
FIGMA_OAUTH_CALLBACK_URL=

# OAuth - Atlassian
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
ATLASSIAN_OAUTH_CALLBACK_URL=

# GitHub Deployment Workflow
GITHUB_DEPLOY_TOKEN=
GITHUB_DEPLOY_REPO_OWNER=
GITHUB_DEPLOY_REPO_NAME=
GITHUB_DEPLOY_WORKFLOW_ID=
GITHUB_DEPLOY_REF=main

# GitHub Source Repository
GITHUB_REPO_PAT=
GITHUB_SOURCE_REPO_OWNER=
GITHUB_SOURCE_REPO_NAME=
GITHUB_SOURCE_REPO_BRANCH=

# S3 Assets
S3_ASSETS_BUCKET=servly-assets
S3_SOURCE_ARTIFACTS_BUCKET=servly-source-artifacts
S3_ENDPOINT=

# Instance deployment routing
SERVLY_APP_ROOT_DOMAIN=servly.app
SERVLY_APP_HOSTED_ZONE_ID=
DEPLOYMENT_DOMAIN_ROUTING_MODE=alb
DEPLOYMENT_DOMAIN_CLOUDFRONT_DISTRIBUTION_ID=
